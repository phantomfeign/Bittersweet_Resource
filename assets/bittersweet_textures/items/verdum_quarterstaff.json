{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:display_context",
    "cases": [
      {
        "when": [
          "gui",
          "ground",
          "fixed",
          "on_shelf"
        ],
        "model": {
          "type": "minecraft:select",
          "property": "minecraft:charge_type",
          "cases": [
            {
              "when": "none",
              "model": {
                "type": "minecraft:range_dispatch",
                "property": "minecraft:time",
                "source": "daytime",
                "scale": 1,
                "entries": [
                  {
                    "threshold": 0,
                    "model": {
                      "type": "minecraft:model",
                      "model": "bittersweet_textures:item/verdum_quarterstaff"
                    }
                  },
                  {
                    "threshold": 0.5,
                    "model": {
                      "type": "minecraft:model",
                      "model": "bittersweet_textures:item/verdum_quarterstaff_day"
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ],
    "fallback": {
      "type": "minecraft:select",
      "property": "minecraft:charge_type",
      "cases": [
        {
          "when": "none",
          "model": {
            "type": "minecraft:range_dispatch",
            "property": "minecraft:time",
            "source": "daytime",
            "scale": 1,
            "entries": [
              {
                "threshold": 0,
                "model": {
                  "type": "minecraft:model",
                  "model": "bittersweet_textures:item/verdum_quarterstaff_held"
                }
              },
              {
                "threshold": 0.5,
                "model": {
                  "type": "minecraft:model",
                  "model": "bittersweet_textures:item/verdum_quarterstaff_held_day"
                }
              }
            ]
          }
        }
      ]
    }
  }
}
